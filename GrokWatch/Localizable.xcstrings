    "Web" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web"
          }
        }
      }
    },
    "When the text field opens, the iPhone offers to type for the watch: paste the key there. It starts with xai-." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand la saisie s’ouvre, l’iPhone propose de taper à la place de la montre : collez-y la clé, qui commence par xai-."
          }
        }
      }
    },
    "With no thinking, the answer comes fastest." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans réflexion, la réponse arrive le plus vite."
          }
        }
      }
    },
    "X" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "X"
          }
        }
      }
    },
