      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrire une question"
          }
        }
      }
    },
    "Unexpected answer from SpaceXSI: %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réponse inattendue de SpaceXSI : %@"
          }
        }
