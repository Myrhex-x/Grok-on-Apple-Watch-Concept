    "Grok" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grok"
          }
        }
      }
    },
    "Grok answers with your own API key. It stays on the watch and is only used to reach api.x.ai." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grok répond avec votre propre clé d’API. Elle reste sur la montre et ne sert qu’à joindre api.x.ai."
          }
        }
      }
    },
    "Grok can’t use the microphone. Allow it in Settings > Privacy & Security > Microphone." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grok n’a pas accès au micro. Autorisez-le dans Réglages > Confidentialité et sécurité > Micro."
          }
        }
      }
    },
    "Grok didn’t answer. Try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grok n’a rien répondu. Réessayez."
          }
        }
      }
    },
    "Grok is writing" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grok écrit"
          }
        }
      }
    },
    "Grok only searches when the question needs it. An X search costs about $0.10." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grok ne cherche que si la question le demande. Une recherche sur X coûte environ 0,10 $."
          }
        }
      }
    },
    "Grok stops working on this watch in %lld days. Install it again from the Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grok s’arrêtera dans %lld jours sur cette montre. Relancez l’installation depuis le Mac."
          }
        }
      }
    },
    "Grok stops working on this watch today. Install it again from the Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grok s’arrête aujourd’hui sur cette montre. Relancez l’installation depuis le Mac."
          }
        }
      }
    },
    "Grok stops working on this watch tomorrow. Install it again from the Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grok s’arrête demain sur cette montre. Relancez l’installation depuis le Mac."
          }
        }
      }
    },
    "Grok stops working on your watch in a week, %@. Connect the iPhone to the Mac and install it again to keep it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grok s’arrêtera sur votre montre dans une semaine, %@. Branchez l’iPhone au Mac et relancez l’installation pour le garder."
          }
        }
      }
    },
    "Grok stops working on your watch tomorrow at %@. Install it again from the Mac tonight." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grok s’arrête demain sur votre montre, à %@. Relancez l’installation depuis le Mac ce soir."
          }
        }
      }
    },
    "Grok stops working soon" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grok expire bientôt"
          }
        }
      }
    },
    "I didn’t hear anything. Tap the microphone and speak." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
