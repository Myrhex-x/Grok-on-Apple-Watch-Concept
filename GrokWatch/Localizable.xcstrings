    "SpaceXSI error %lld: %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erreur SpaceXSI %1$lld : %2$@"
          }
        }
      }
    },
    "SpaceXSI is taking too long to answer. Try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SpaceXSI met trop de temps à répondre. Réessayez."
          }
        }
      }
    },
    "SpaceXSI key received from the Mac. Grok is ready." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clé SpaceXSI reçue du Mac. Grok est prêt."
          }
        }
      }
    },
    "SpaceXSI refused the request. Check your team’s credits on console.x.ai." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SpaceXSI a refusé la demande. Vérifiez les crédits de votre équipe sur console.x.ai."
          }
        }
      }
    },
    "SpaceXSI rejects this key. Check it in Settings." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SpaceXSI refuse cette clé. Vérifiez-la dans les Réglages."
          }
        }
      }
    },
    "SpaceXSI returned an error (%lld)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SpaceXSI a renvoyé une erreur (%lld)."
          }
        }
      }
    },
    "Speak" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parler"
          }
        }
      }
    },
    "Spoken language" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langue parlée"
          }
        }
      }
    },
    "Stop the answer" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêter la réponse"
          }
        }
      }
    },
    "Test build, no end date." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version de test, sans date de fin."
          }
        }
      }
    },
    "The answer didn’t come through." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réponse n’est pas arrivée."
          }
        }
      }
    },
    "The connection dropped before the answer was done." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion a été coupée avant la fin de la réponse."
          }
        }
      }
    },
    "The key stays in the watch’s Keychain. It isn’t backed up anywhere, and it’s only ever sent to api.x.ai." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé reste dans le trousseau de la montre. Elle n’est ni sauvegardée ailleurs, ni envoyée ailleurs qu’à api.x.ai."
          }
        }
      }
    },
    "The microphone couldn’t start." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le micro n’a pas pu démarrer."
          }
        }
      }
    },
    "The microphone isn’t available right now." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le micro n’est pas disponible pour le moment."
          }
        }
      }
    },
    "The microphone isn’t responding. Try again in a moment." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le micro ne répond pas. Réessayez dans un instant."
          }
        }
      }
    },
    "The microphone stops when you stop talking. SpaceXSI turns the audio into text, for about $0.10 per hour of audio." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le micro s’arrête quand vous ne parlez plus. SpaceXSI transforme l’audio en texte, pour environ 0,10 $ par heure d’audio."
          }
        }
      }
    },
    "The model %@ isn’t available for this key." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle %@ n’est pas disponible pour cette clé."
          }
        }
      }
    },
    "The watch couldn’t save the key." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La montre n’a pas pu enregistrer la clé."
          }
        }
      }
    },
    "Thinking" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réflexion"
          }
        }
      }
    },
    "This month" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mois-ci"
          }
        }
      }
    },
    "To extend it, connect the iPhone to the Mac and install again. A reminder comes a week before." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour prolonger, branchez l’iPhone au Mac et relancez l’installation. Un rappel arrive une semaine avant."
          }
        }
      }
    },
    "Too many requests for this key. Try again in a moment." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de demandes pour cette clé. Réessayez dans un instant."
          }
        }
      }
    },
    "Transcribing" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcription"
          }
        }
      }
    },
    "Try again" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réessayer"
          }
        }
      }
    },
    "Two days left before Grok stops working on your watch (%@). Install it again from the Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus que deux jours avant que Grok s’arrête sur votre montre (%@). Relancez l’installation depuis le Mac."
          }
        }
      }
    },
    "Type" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrire"
          }
        }
      }
    },
